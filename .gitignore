# Python Virtual Environment
# I have chosen not to ignore these at present as it will speed up cross-device development.
Lib/
Scripts/
Include/
pyvenv.cfg
 .env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# pytest cache (also disabled via -p no:cacheprovider; this is a safety net)
.pytest_cache/
pytest-cache-files-*/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Logs
logs/
*.log
log.txt

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
.cursor/
.claude/


# OS specific files
.DS_Store
Thumbs.db

# Project specific
config/active_config.json 
active_config.json

# Brief
brief/

# Video recordings
rec/
videos/
*.mp4
*.ts
*.h264

# Work in progress
wip/
test.sh

# Share folder
habitat_share/

# Setup files
system_setup_summary.txt
system_setup.log

# Logging
*.log
log/
**/var/log/

# Node
node_modules/
.claude/worktrees/

# MkDocs build output
site/

# Generated run output — never meant to be committed
framesync_summary.csv
saviour_uninstall_summary.txt

# Hailo HEFs: the model-zoo nets are fetched by
# src/modules/variants/hailo_camera/download_hefs.sh, so don't track them.
# Custom, non-reproducible nets (e.g. the rat detectors) ARE tracked.
hailo_models/*.hef
hailo_models/.arch
!hailo_models/topdown_rats_yolov8_640_nms.hef
!hailo_models/multiangle_rats_yolo11n_640_nms.hef
