{
    "controller": {
        "_max_buffer_size": 2000,
        "_manual_control": true,
        "_print_received_data": false,
        "name": "",
        "location": ""
    },
    "zeroconf": {
        "_port": 5353,
        "_service_type": "_controller._tcp.local.",
        "_service_name": "controller._controller._tcp.local.",
        "_valid_ip_prefixes": ["192.168.1.", "10.0."]
    },
    "zmq": {
        "_cmd_port": 5555,
        "_status_port": 5556,
        "_host": "0.0.0.0"
    },
    "health": {
        "_heartbeat_interval": 30,
        "_heartbeat_timeout": 60
    },
    "ptp": {
        "_ptp_monitor_interval": 10
    },
    "data_export": {
        "_export_interval": 15,
        "_health_export_interval": 30
    },
    "export": {
        "max_concurrent_exports": 1,
        "mount_path": "/home/pi/controller_share"
    },
    "recording": {
        "ptp_start_gate_us": 50.0,
        "ptp_threshold_us": 1000.0,
        "nas_min_free_pct": 5,
        "nas_warn_free_pct": 15,
        "local_min_free_pct": 10,
        "export_stale_mins": 150,
        "expected_module_counts": {},
        "ptp_gate_us": 50.0,
        "ptp_amber_us": 250.0,
        "framesync_detrended_p95_green_us": 20.0,
        "framesync_detrended_p95_amber_us": 200.0,
        "framesync_drift_accum_halfframe_frac_amber": 0.5,
        "framesync_drift_accum_halfframe_frac_red": 1.0,
        "framesync_dropped_frac_amber": 0.001,
        "framesync_dropped_frac_red": 0.02,
        "framesync_rate_cv_amber": 0.05,
        "framesync_fps_dev_amber": 0.02,
        "framesync_artefact_frac_amber": 0.05,
        "framesync_cap_rows": 500000,
        "framesync_habitat_cap_rows": 200000,
        "framesync_health_cap_rows": 200000,
        "framesync_day_settle_hours": 1
    },
    "logging": {
        "_level": "INFO",
        "_format": "%(levelname)s - %(name)s - %(message)s",
        "_file_logging": false,
        "_directory": "/var/log/habitat"
    },
    "interface": {
        "_cli": false,
        "_web_interface": true,
        "_web_interface_port": 5000
    },
    "teams": {
        "webhook_url": "",
        "alert_cooldown_secs": 600,
        "notify_recording_started": true,
        "notify_recording_stopped": false,
        "notify_daily_summary": true,
        "notify_session_faults": true,
        "notify_module_offline": true,
        "notify_module_online": false,
        "notify_ptp_degraded": true,
        "notify_recording_health": true,
        "notify_disk_space": true
    },
    "frontend": {
        "theme_id": "default",
        "dark_mode": true,
        "accent_color": "#6495ed",
        "custom_themes": []
    }
} 
