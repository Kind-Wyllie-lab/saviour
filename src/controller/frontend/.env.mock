# Loaded by Vite only for `npm run dev:mock` (which runs `vite --mode mock`).
# Keeps the mock flag out of inline shell syntax so the script works on
# Windows/PowerShell as well as POSIX shells. vite.config.js reads this via
# loadEnv(); src/socket.jsx sees it as import.meta.env.VITE_MOCK.
VITE_MOCK=1
