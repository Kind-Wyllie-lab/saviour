{
  "module": {
    "_heartbeat_interval": 30,
    "name": "",
    "group": ""
  },
  "network": {
    "_zeroconf_port": 5353,
    "_zeroconf_service_type": "_module._tcp.local.",
    "_valid_ip_prefixes": ["192.168.1.", "10.0."],
    "_ip_wait_secs": 60,
    "_network_ready_wait_secs": 120
  },
  "communication": {
    "_command_socket_port": 5555,
    "_status_socket_port": 5556,
    "missed_ack_threshold": 4
  },
  "logging": {
    "_level": "INFO",
    "_format": "%(asctime)s - %(levelname)s - %(message)s"
  },
  "recording": {
    "segment_length_mins": 60,
    "local_min_free_pct": 10,
    "fix_positioning_timestamps": true,
    "_recording_folder": "/var/lib/saviour/recordings",
    "_record_health_metadata": true,
    "_health_metadata_recording_interval": 5,
    "_health_check_interval_secs": 10,
    "_health_check_strikes": 2,
    "_health_check_camera_silence_secs": 5,
    "_cadence_window_secs": 10.0,
    "_cadence_min_samples": 30,
    "_cadence_rate_cv_warn": 0.08,
    "_cadence_dropped_frac_warn": 0.005,
    "_cadence_fps_floor_frac": 0.8
  },
  "export": {
    "auto_export": true,
    "delete_on_export": true,
    "_manifest_enabled": false,
    "share_ip": "10.0.0.1",
    "share_path": "controller_share",
    "share_username": "saviour_module",
    "max_bitrate_mb": 100,
    "max_burst_kb": 30
  }
}
