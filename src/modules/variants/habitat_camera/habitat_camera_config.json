{
    "module": {
        "group": "habitat_camera"
    },
    "camera": {
        "monochrome": false,
        "hflip": false,
        "vflip": false,
        "rotation": 0,
        "crop_rect": null,
        "sensor_mode_index": 2,
        "width": 1920,
        "height": 1080,
        "fps": 30,
        "overlay_timestamp": true,
        "text_size": "medium",
        "gain": 1,
        "manual_exposure": false,
        "exposure_time": 10000,
        "ae_enable": true,
        "brightness": 0,
        "contrast": 1.0,
        "sharpness": 1.0,
        "noise_reduction_mode": "fast",
        "exposure_value": 0.0,
        "ae_metering_mode": "centre_weighted",
        "ae_constraint_mode": "normal",
        "ae_exposure_mode": "normal",
        "overlay_framerate_on_preview": true,
        "_codec": "h264",
        "_profile": "high",
        "_level": 4.2,
        "bitrate_mb": 2,
        "exposure_warn_pct": 5.0,
        "exposure_overlay": true,
        "exposure_clip_high": 250,
        "exposure_clip_low": 5,
        "exposure_check_interval_s": 1.0,
        "autofocus_mode": "manual",
        "lens_position": 0.0,
        "sync_mode": "none",
        "framesync_enabled": true,
        "sync_lock_exposure": false,
        "sync_lock_awb": false,
        "livestream_quality": "normal"
    },
    "recording": {
        "_recording_filetype": "ts"
    },
    "habitat_motion": {
        "algorithm": "frame_diff",
        "activity_threshold": 0.0005,
        "activity_min_duration_s": 0.5,
        "inactivity_min_duration_s": 300.0,
        "pre_roll_secs": 3.0,
        "ae_settle_s": 0.75,
        "process_width": 256,
        "_mog2_history": 500,
        "_mog2_var_threshold": 16
    },
    "occupancy": {
        "enabled": false,
        "model_path": "models/rats_yolov8n_416.onnx",
        "interval_s": 2.0,
        "threshold": 0.35,
        "confirm_samples": 2,
        "clear_secs": 30.0,
        "target_class": null,
        "_note": "OR-fused with habitat_motion: keeps recording while a rat is in frame even when still. YOLOv8n rat detector; occupancy score = highest detection confidence in the frame. Needs onnxruntime (env/bin/pip install onnxruntime). model_path is relative to the variant folder. Set enabled:true after checking threshold against the livestream '[subject NN]' readout."
    }
}
