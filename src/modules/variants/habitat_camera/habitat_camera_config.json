{
    "module": {
        "group": "habitat_camera"
    },
    "camera": {
        "monochrome": false,
        "hflip": false,
        "vflip": false,
        "rotation": 0,
        "crop_rect": null,
        "sensor_mode_index": 2,
        "width": 1920,
        "height": 1080,
        "fps": 30,
        "overlay_timestamp": true,
        "text_size": "medium",
        "gain": 1,
        "manual_exposure": false,
        "exposure_time": 10000,
        "ae_enable": true,
        "brightness": 0,
        "contrast": 1.0,
        "overlay_framerate_on_preview": true,
        "_codec": "h264",
        "_profile": "high",
        "_level": 4.2,
        "bitrate_mb": 2,
        "autofocus_mode": "manual",
        "lens_position": 0.0,
        "sync_mode": "none",
        "framesync_enabled": true,
        "sync_lock_exposure": false,
        "sync_lock_awb": false,
        "livestream_quality": "normal"
    },
    "recording": {
        "_recording_filetype": "ts"
    },
    "habitat_motion": {
        "algorithm": "frame_diff",
        "activity_threshold": 0.02,
        "activity_min_duration_s": 1.0,
        "inactivity_min_duration_s": 300.0,
        "pre_roll_secs": 3.0,
        "ae_settle_s": 0.75,
        "process_width": 256,
        "_mog2_history": 500,
        "_mog2_var_threshold": 16
    }
}
